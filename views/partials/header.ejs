<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · <%= settings.business_name %></title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<% if (user) { %>
<header class="topbar">
  <a class="brand" href="/"><span class="logo">PH</span> <%= settings.business_name %></a>
  <nav>
    <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Dashboard</a>
    <a href="/customers" class="<%= currentPath.startsWith('/customers') ? 'active' : '' %>">Customers</a>
    <a href="/inventory" class="<%= currentPath.startsWith('/inventory') ? 'active' : '' %>">Inventory</a>
    <a href="/deals" class="<%= currentPath.startsWith('/deals') ? 'active' : '' %>">Deals</a>
    <a href="/tasks" class="<%= currentPath.startsWith('/tasks') ? 'active' : '' %>">Tasks<% if (tasksDue) { %> <span class="badge"><%= tasksDue %></span><% } %></a>
    <% if (isManager) { %>
      <a href="/books" class="<%= currentPath.startsWith('/books') ? 'active' : '' %>">Books</a>
      <a href="/reports" class="<%= currentPath.startsWith('/reports') ? 'active' : '' %>">Reports</a>
      <a href="/users" class="<%= currentPath.startsWith('/users') ? 'active' : '' %>">Staff</a>
      <a href="/settings" class="<%= currentPath.startsWith('/settings') ? 'active' : '' %>">Settings</a>
    <% } else if (user.commission_plan && user.commission_plan !== 'none') { %>
      <a href="/my/commissions" class="<%= currentPath.startsWith('/my') ? 'active' : '' %>">My commission</a>
    <% } %>
  </nav>
  <form class="topsearch" method="get" action="/search" role="search">
    <input type="search" name="q" placeholder="Search name, phone, stock #…" aria-label="Search">
  </form>
  <div class="account">
    <span class="who"><%= user.full_name %> <span class="role-badge role-<%= user.role %>"><%= ROLES[user.role] %></span></span>
    <a href="/account/password">Password</a>
    <form method="post" action="/logout" class="inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="link">Sign out</button>
    </form>
  </div>
</header>
<% } %>
<main class="<%= user ? 'container' : 'container narrow' %>">
<% if (flash) { %>
  <div class="flash flash-<%= flash.type %>"><%= flash.message %>
    <% if (flash.link) { %> <a href="<%= flash.link.href %>" target="_blank" rel="noopener"><%= flash.link.label %></a><% } %></div>
<% } %>

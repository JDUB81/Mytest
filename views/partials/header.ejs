<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Premier Homes</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<% if (user) { %>
<header class="topbar">
  <a class="brand" href="/"><span class="logo">PH</span> Premier Homes</a>
  <nav>
    <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Dashboard</a>
    <a href="/inventory" class="<%= currentPath.startsWith('/inventory') ? 'active' : '' %>">Inventory</a>
    <a href="/customers" class="<%= currentPath.startsWith('/customers') ? 'active' : '' %>">Customers</a>
    <% if (isManager) { %>
      <a href="/users" class="<%= currentPath.startsWith('/users') ? 'active' : '' %>">Staff</a>
    <% } %>
  </nav>
  <div class="account">
    <span class="who"><%= user.full_name %> <span class="role-badge role-<%= user.role %>"><%= ROLES[user.role] %></span></span>
    <a href="/account/password">Password</a>
    <form method="post" action="/logout" class="inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="link">Sign out</button>
    </form>
  </div>
</header>
<% } %>
<main class="<%= user ? 'container' : 'container narrow' %>">
<% if (flash) { %>
  <div class="flash flash-<%= flash.type %>"><%= flash.message %></div>
<% } %>

<%- include('../partials/header') %>
<div class="page-head">
  <h1>Staff accounts</h1>
  <a class="btn primary" href="/users/new">+ New account</a>
</div>
<div class="card access-legend">
  <p><span class="role-badge role-manager">Manager</span> Everything a Sales Associate can do, plus: add/edit inventory and photos, see dealer cost and gross profit, mark deals sold or cancel them, refund or void payments, edit closed deals, reports and exports, settings, activity log and staff logins.</p>
  <p><span class="role-badge role-sales">Sales Associate</span> Add/edit customers, notes and tasks; view inventory; assign available homes to customers; price pending deals (add-ons, trade-in, financing); take deposits and payments; print buyer's orders and receipts.</p>
</div>
<div class="card table-wrap">
  <table>
    <thead><tr><th>Name</th><th>Username</th><th>Access level</th><th>Status</th><th>Created</th><th></th></tr></thead>
    <tbody>
    <% users.forEach(function (u) { %>
      <tr class="<%= u.active ? '' : 'inactive' %>">
        <td><%= u.full_name %></td>
        <td><%= u.username %></td>
        <td><span class="role-badge role-<%= u.role %>"><%= ROLES[u.role] %></span></td>
        <td><%= u.active ? 'Active' : 'Disabled' %></td>
        <td><%= formatDate(u.created_at) %></td>
        <td><a href="/users/<%= u.id %>/edit">Edit</a></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>

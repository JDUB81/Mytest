<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <p class="crumb"><a href="/inventory">Inventory</a> /</p>
    <h1>Stock #<%= home.stock_number %> <span class="status status-<%= home.status %>"><%= statusLabel(home.status) %></span></h1>
    <p class="muted"><%= home.year || '' %> <%= home.manufacturer %> <%= home.model %> · <%= home.home_type %>
      <% var days = daysSince(home.arrival_date || home.created_at); if (home.status === 'available' && days !== null) { %> · <span class="<%= days > 90 ? 'aging' : '' %>"><%= days %> days on lot</span><% } %></p>
  </div>
  <div class="actions">
    <% if (isManager) { %><a class="btn" href="/inventory/<%= home.id %>/edit">Edit</a><% } %>
  </div>
</div>

<% if (photos.length || isManager) { %>
<section class="card" id="photos">
  <h2>Photos</h2>
  <% if (photos.length) { %>
    <div class="gallery">
      <% photos.forEach(function (p) { %>
        <figure>
          <a href="/photos/<%= p.id %>" target="_blank" rel="noopener"><img src="/photos/<%= p.id %>" alt="<%= p.original_name || 'Home photo' %>" loading="lazy"></a>
          <% if (isManager) { %>
            <form method="post" action="/inventory/<%= home.id %>/photos/<%= p.id %>/delete" onsubmit="return confirm('Remove this photo?')">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="link small" type="submit">Remove</button>
            </form>
          <% } %>
        </figure>
      <% }) %>
    </div>
  <% } else { %>
    <p class="muted">No photos yet.</p>
  <% } %>
  <% if (isManager) { %>
    <form method="post" action="/inventory/<%= home.id %>/photos?_csrf=<%= csrfToken %>" enctype="multipart/form-data" class="upload-row">
      <input type="file" name="photos" accept="image/jpeg,image/png,image/webp,image/gif" multiple required>
      <button class="btn" type="submit">Upload photos</button>
    </form>
  <% } %>
</section>
<% } %>

<div class="grid-2">
  <section class="card">
    <h2>Details</h2>
    <dl class="details">
      <dt>List price</dt><dd><strong><%= formatMoney(home.price) %></strong></dd>
      <% if (isManager) { %>
        <dt>Dealer cost</dt><dd><%= home.invoice_cost == null ? 'Not entered' : formatMoney((home.invoice_cost || 0) + (home.freight_cost || 0) + (home.other_cost || 0)) %>
          <% if (home.invoice_cost != null && home.price) { %><span class="muted small"> · margin at list <%= formatMoney(home.price - (home.invoice_cost || 0) - (home.freight_cost || 0) - (home.other_cost || 0)) %></span><% } %></dd>
      <% } %>
      <dt>Bedrooms / Baths</dt><dd><%= home.bedrooms ?? '—' %> / <%= home.bathrooms ?? '—' %></dd>
      <dt>Square feet</dt><dd><%= home.square_feet ? home.square_feet.toLocaleString() : '—' %></dd>
      <dt>Dimensions</dt><dd><%= home.width_ft && home.length_ft ? home.width_ft + "' × " + home.length_ft + "'" : '—' %></dd>
      <dt>Exterior</dt><dd><%= home.exterior_color || '—' %></dd>
      <dt>Serial / VIN</dt><dd><%= home.serial_number || '—' %></dd>
      <dt>Lot location</dt><dd><%= home.location || '—' %></dd>
      <dt>Arrived</dt><dd><%= formatDate(home.arrival_date || home.created_at) %></dd>
    </dl>
    <% if (home.features) { %><h3>Features &amp; options</h3><p class="notes"><%= home.features %></p><% } %>
    <% if (home.notes) { %><h3>Internal notes</h3><p class="notes"><%= home.notes %></p><% } %>
  </section>

  <section class="card" id="assign">
    <h2>Customer &amp; deal</h2>
    <% if (activeDeal) { %>
      <p><a href="/customers/<%= activeDeal.customer_id %>"><strong><%= activeDeal.first_name %> <%= activeDeal.last_name %></strong></a>
        <span class="status status-<%= activeDeal.status %>"><%= statusLabel(activeDeal.status) %></span></p>
      <p class="muted">Deal opened <%= formatDate(activeDeal.created_at) %><%= activeDeal.salesperson_name ? ' · ' + activeDeal.salesperson_name : '' %></p>
      <a class="btn primary" href="/deals/<%= activeDeal.id %>">Open deal #<%= activeDeal.id %></a>
    <% } else if (home.status === 'available') { %>
      <% if (!customers.length) { %>
        <p class="muted">No customers yet. <a href="/customers/new">Add a customer</a> first, then assign this home.</p>
      <% } else { %>
        <form method="post" action="/inventory/assign" class="stack">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="inventory_id" value="<%= home.id %>">
          <label>Assign to existing customer
            <select name="customer_id" required>
              <option value="">Choose a customer…</option>
              <% customers.forEach(function (c) { %>
                <option value="<%= c.id %>"><%= c.last_name %>, <%= c.first_name %><%= c.phone ? ' — ' + c.phone : '' %></option>
              <% }) %>
            </select>
          </label>
          <button class="btn primary" type="submit">Assign home &amp; open deal</button>
        </form>
      <% } %>
    <% } else { %>
      <p class="muted">Not assigned.</p>
    <% } %>
    <% var past = deals.filter(function (d) { return d.status === 'cancelled'; }); if (past.length) { %>
      <h3>Cancelled deals</h3>
      <ul class="plain">
        <% past.forEach(function (d) { %><li><a href="/deals/<%= d.id %>">#<%= d.id %></a> — <%= d.first_name %> <%= d.last_name %>, cancelled <%= formatDate(d.cancelled_at) %></li><% }) %>
      </ul>
    <% } %>
  </section>
</div>

<div class="grid-2">
  <section class="card" id="notes">
    <h2>Notes</h2>
    <%- include('../partials/note-form', { field: 'inventory_id', value: home.id }) %>
    <%- include('../partials/timeline', { entries: notes.map(function (n) { return Object.assign({ type: 'note' }, n); }) }) %>
  </section>
  <section class="card">
    <h2>History</h2>
    <%- include('../partials/timeline', { entries: activity.map(function (a) { return Object.assign({ type: 'activity' }, a); }) }) %>
  </section>
</div>

<% if (isManager && !deals.length) { %>
  <form method="post" action="/inventory/<%= home.id %>/delete" class="danger-zone"
        onsubmit="return confirm('Delete this home from inventory? This cannot be undone.')">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn danger" type="submit">Delete this home</button>
  </form>
<% } %>
<%- include('../partials/footer') %>

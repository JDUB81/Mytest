<%- include('../partials/header') %>
<h1><%= title %></h1>
<%- include('../partials/errors', { errors: errors }) %>
<form method="post" action="<%= home.id ? '/inventory/' + home.id : '/inventory' %>" class="card">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <fieldset>
    <legend>Identification</legend>
    <div class="grid-3">
      <label>Stock number * <input name="stock_number" value="<%= home.stock_number || '' %>" required></label>
      <label>Serial / VIN <input name="serial_number" value="<%= home.serial_number || '' %>"></label>
      <label>Lot location <input name="location" value="<%= home.location || '' %>" placeholder="e.g. Lot 4, Row B"></label>
      <label>Arrival date <input type="date" name="arrival_date" value="<%= home.arrival_date || '' %>"></label>
    </div>
  </fieldset>
  <fieldset>
    <legend>Home</legend>
    <div class="grid-3">
      <label>Manufacturer * <input name="manufacturer" value="<%= home.manufacturer || '' %>" required></label>
      <label>Model * <input name="model" value="<%= home.model || '' %>" required></label>
      <label>Year <input name="year" inputmode="numeric" value="<%= home.year ?? '' %>"></label>
      <label>Home type *
        <select name="home_type" required>
          <option value="">Choose…</option>
          <% HOME_TYPES.forEach(function (t) { %>
            <option value="<%= t %>" <%= home.home_type === t ? 'selected' : '' %>><%= t %></option>
          <% }) %>
        </select>
      </label>
      <label>Bedrooms <input name="bedrooms" inputmode="numeric" value="<%= home.bedrooms ?? '' %>"></label>
      <label>Bathrooms <input name="bathrooms" inputmode="decimal" value="<%= home.bathrooms ?? '' %>"></label>
      <label>Square feet <input name="square_feet" inputmode="numeric" value="<%= home.square_feet ?? '' %>"></label>
      <label>Width (ft) <input name="width_ft" inputmode="numeric" value="<%= home.width_ft ?? '' %>"></label>
      <label>Length (ft) <input name="length_ft" inputmode="numeric" value="<%= home.length_ft ?? '' %>"></label>
      <label>Exterior / colors <input name="exterior_color" value="<%= home.exterior_color || '' %>" placeholder="e.g. Gray siding, white trim"></label>
    </div>
    <label>Features &amp; options
      <textarea name="features" rows="3" placeholder="e.g. Kitchen island, walk-in shower, vaulted ceilings, 2x6 walls…"><%= home.features || '' %></textarea></label>
  </fieldset>
  <fieldset>
    <legend>Pricing</legend>
    <div class="grid-3">
      <label>List price ($) <input name="price" inputmode="decimal" value="<%= home.price ?? '' %>"></label>
    </div>
    <div class="manager-box">
      <p class="small muted">Dealer cost — visible to managers only. Used for gross profit on reports.</p>
      <div class="grid-3">
        <label>Invoice cost ($) <input name="invoice_cost" inputmode="decimal" value="<%= home.invoice_cost ?? '' %>"></label>
        <label>Freight ($) <input name="freight_cost" inputmode="decimal" value="<%= home.freight_cost ?? '' %>"></label>
        <label>Other cost ($) <input name="other_cost" inputmode="decimal" value="<%= home.other_cost ?? '' %>" placeholder="Prep, setup reserve…"></label>
      </div>
    </div>
  </fieldset>
  <fieldset>
    <legend>Website</legend>
    <div class="grid-3">
      <label>Listing
        <select name="listing">
          <option value="stock" <%= home.listing !== 'order' ? 'selected' : '' %>>On the lot (stock)</option>
          <option value="order" <%= home.listing === 'order' ? 'selected' : '' %>>Build to order (factory model)</option>
        </select>
      </label>
      <label class="check"><input type="checkbox" name="show_on_website" value="1" <%= home.show_on_website ? 'checked' : '' %>> Show on public website</label>
      <label class="check"><input type="checkbox" name="featured" value="1" <%= home.featured ? 'checked' : '' %>> Feature on home page</label>
    </div>
    <label>Website description
      <textarea name="web_description" rows="3" placeholder="What buyers see on the website. Leave blank to show the features list."><%= home.web_description || '' %></textarea></label>
    <p class="small muted">Dealer cost and internal notes are never shown on the website. Only homes that are available appear there.</p>
  </fieldset>
  <fieldset>
    <legend>Notes</legend>
    <label>Internal notes <textarea name="notes" rows="3"><%= home.notes || '' %></textarea></label>
  </fieldset>
  <div class="actions">
    <button class="btn primary" type="submit"><%= home.id ? 'Save changes' : 'Add to inventory' %></button>
    <a href="<%= home.id ? '/inventory/' + home.id : '/inventory' %>">Cancel</a>
  </div>
</form>
<%- include('../partials/footer') %>

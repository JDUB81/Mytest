<%- include('partials/header') %>
<div class="page-head">
  <h1>Welcome, <%= user.full_name.split(' ')[0] %></h1>
  <div class="actions">
    <a class="btn primary" href="/customers/new">+ New customer</a>
    <% if (isManager) { %><a class="btn" href="/inventory/new">+ Add inventory</a><% } %>
  </div>
</div>

<div class="stats">
  <a class="stat" href="/inventory?status=available"><span class="num"><%= counts.available %></span><span>Homes available</span></a>
  <a class="stat" href="/deals?status=pending"><span class="num"><%= counts.pending %></span><span>Pending sales</span></a>
  <a class="stat" href="/deals?status=sold"><span class="num"><%= month.units %></span><span>Sold this month<%= isManager ? '' : ' (you)' %></span></a>
  <a class="stat" href="/customers"><span class="num"><%= openCustomers %></span><span>Open leads · <%= month.newLeads %> new this month</span></a>
</div>
<% if (isManager) { %>
<div class="stats">
  <div class="stat"><span class="num"><%= formatMoney(month.revenue) %></span><span>Sales this month</span></div>
  <div class="stat"><span class="num"><%= formatMoney(month.grossProfit) %></span><span>Gross profit this month</span></div>
  <div class="stat"><span class="num"><%= formatMoney(month.collected) %></span><span>Collected this month</span></div>
  <a class="stat" href="/reports"><span class="num">→</span><span>Full reports</span></a>
</div>
<% } %>

<div class="grid-2">
  <section class="card">
    <div class="card-head"><h2>My tasks due</h2><a href="/tasks">All tasks</a></div>
    <% if (!tasks.length) { %>
      <p class="muted">Nothing due. <a href="/tasks">Add a task</a></p>
    <% } else { %>
      <ul class="task-list">
      <% tasks.forEach(function (t) { %>
        <li class="<%= t.due_date && t.due_date < todayStr ? 'overdue' : '' %>">
          <form method="post" action="/tasks/<%= t.id %>/done" class="inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="from" value="dashboard">
            <button class="check-btn" type="submit" title="Mark done" aria-label="Mark done">✓</button>
          </form>
          <div>
            <strong><%= t.title %></strong>
            <div class="small muted">
              <%= t.due_date ? (t.due_date < todayStr ? 'Overdue · ' : 'Due today · ') + formatDate(t.due_date) : 'No due date' %>
              <% if (t.customer_id) { %> · <a href="/customers/<%= t.customer_id %>"><%= t.first_name %> <%= t.last_name %></a><% } %>
            </div>
          </div>
        </li>
      <% }) %>
      </ul>
    <% } %>
  </section>

  <section class="card">
    <div class="card-head"><h2>Follow-ups due</h2><a href="/customers?follow_up=due&stage=all">See all</a></div>
    <% if (!followUps.length) { %>
      <p class="muted">No customer follow-ups due.</p>
    <% } else { %>
      <table>
        <tbody>
        <% followUps.forEach(function (c) { %>
          <tr class="<%= c.follow_up_date < todayStr ? 'overdue' : '' %>">
            <td><a href="/customers/<%= c.id %>"><strong><%= c.first_name %> <%= c.last_name %></strong></a>
              <div class="small muted"><%= LEAD_STATUSES[c.lead_status] %><%= c.salesperson_name ? ' · ' + c.salesperson_name : '' %></div></td>
            <td><% if (c.phone) { %><a href="tel:<%= c.phone %>"><%= c.phone %></a><% } %></td>
            <td class="num small"><%= formatDate(c.follow_up_date) %></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>
</div>

<section class="card">
  <div class="card-head"><h2><%= isManager ? 'Pending deals' : 'My pending deals' %></h2><a href="/deals">All deals</a></div>
  <% if (!pending.length) { %>
    <p class="muted">No pending deals. Assign a home to a customer to start one.</p>
  <% } else { %>
    <div class="table-wrap">
    <table>
      <thead><tr><th>Deal</th><th>Customer</th><th>Home</th><th>Salesperson</th><th class="num">Total</th><th class="num">Paid</th><th class="num">Balance</th></tr></thead>
      <tbody>
      <% pending.forEach(function (d) { %>
        <tr>
          <td><a href="/deals/<%= d.id %>">#<%= d.id %></a></td>
          <td><a href="/customers/<%= d.customer_id %>"><%= d.first_name %> <%= d.last_name %></a></td>
          <td>#<%= d.stock_number %> <%= d.manufacturer %> <%= d.model %></td>
          <td><%= d.salesperson_name || '—' %></td>
          <td class="num"><%= formatMoney(d.totals.total) %></td>
          <td class="num"><%= formatMoney(d.totals.paid) %></td>
          <td class="num"><%= formatMoney(d.totals.balance) %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
    </div>
  <% } %>
</section>
<%- include('partials/footer') %>

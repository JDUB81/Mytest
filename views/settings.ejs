<%- include('partials/header') %>
<h1>Settings</h1>
<%- include('partials/errors', { errors: errors }) %>
<form method="post" action="/settings" class="card">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <fieldset>
    <legend>Business (printed on buyer's orders and receipts)</legend>
    <div class="grid-2">
      <label>Business name <input name="business_name" value="<%= values.business_name %>" required></label>
      <label>Phone <input name="business_phone" value="<%= values.business_phone %>"></label>
      <label>Email <input name="business_email" value="<%= values.business_email %>"></label>
    </div>
    <label>Address <textarea name="business_address" rows="2"><%= values.business_address %></textarea></label>
  </fieldset>
  <fieldset>
    <legend>Public website</legend>
    <label>Tagline (home page headline text) <input name="site_tagline" value="<%= values.site_tagline %>"></label>
    <div class="grid-2">
      <label>Hours <input name="site_hours" value="<%= values.site_hours %>"></label>
      <label>Service area <input name="site_service_area" value="<%= values.site_service_area %>"></label>
    </div>
    <label>About us <textarea name="site_about" rows="3"><%= values.site_about %></textarea></label>
    <label class="check"><input type="checkbox" name="site_show_prices" value="1" <%= values.site_show_prices ? 'checked' : '' %>> Show prices on the website</label>
    <p class="hint">Choose which homes appear, write their descriptions and pick featured homes on each home's Edit page. <a href="/?preview=1" target="_blank" rel="noopener">View the website</a></p>
  </fieldset>
  <fieldset>
    <legend>Deal defaults</legend>
    <div class="grid-3">
      <label>Default sales tax rate (%) <input name="default_tax_rate" inputmode="decimal" value="<%= values.default_tax_rate %>"></label>
      <label>Default documentation fee ($) <input name="default_doc_fee" inputmode="decimal" value="<%= values.default_doc_fee %>"></label>
    </div>
    <p class="hint">Defaults apply to new deals; existing deals keep their own numbers. Tax rules for manufactured homes vary by state — confirm your rate with your accountant.</p>
    <label>Deposit / purchase terms (printed on buyer's orders and deposit receipts)
      <textarea name="deposit_terms" rows="3"><%= values.deposit_terms %></textarea></label>
  </fieldset>
  <fieldset>
    <legend>Commission &amp; checks</legend>
    <div class="grid-3">
      <label>Salesperson commission (% of deal gross profit) <input name="sales_commission_percent" inputmode="decimal" value="<%= values.sales_commission_percent %>"></label>
      <label>General manager commission (% of monthly net profit) <input name="gm_commission_percent" inputmode="decimal" value="<%= values.gm_commission_percent %>"></label>
      <label>Next check number <input name="next_check_number" inputmode="numeric" value="<%= values.next_check_number %>"></label>
    </div>
    <p class="hint">These are the defaults. Give someone a different rate, or choose who is a salesperson or general manager, under <a href="/users">Staff</a>. Deals already sold keep the rate they were sold at.</p>
  </fieldset>
  <div class="actions"><button class="btn primary" type="submit">Save settings</button></div>
</form>
<form method="post" action="/settings/scale" class="card" id="scale">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <h2>Salesman pay scale (Jon Wayne)</h2>
  <p class="small muted">The rate is set by the deal's net profit and applies to the whole deal (not just the part above each step). Used for staff on the "Jon Wayne pay scale" plan.</p>
  <div class="grid-2">
    <% [['single', 'Single-wide'], ['double', 'Double-wide / multi-section']].forEach(function (t) { var rows = scale[t[0]] || []; %>
      <div>
        <h3><%= t[1] %></h3>
        <table class="compact scale-table">
          <thead><tr><th>Deal profit from ($)</th><th>Rate (%)</th></tr></thead>
          <tbody>
          <% for (var i = 0; i < 6; i++) { var r = rows[i] || []; %>
            <tr><td><input name="<%= t[0] %>_from_<%= i %>" inputmode="decimal" value="<%= r[0] ?? '' %>"></td><td><input name="<%= t[0] %>_rate_<%= i %>" inputmode="decimal" value="<%= r[1] ?? '' %>"></td></tr>
          <% } %>
          </tbody>
        </table>
        <label class="inline-label">Minimum profit without manager approval ($) <input name="min_<%= t[0] %>" inputmode="decimal" value="<%= t[0] === 'single' ? scale.min_single : scale.min_double %>" class="short"></label>
      </div>
    <% }) %>
  </div>
  <div class="actions"><button class="btn primary" type="submit">Save pay scale</button></div>
</form>

<div class="grid-2">
<section class="card">
  <h2>Jobs &amp; add-ons</h2>
  <p>One list of jobs (setup, HVAC, skirting, decks…) with price, allotted cost and default vendor, used on every deal.</p>
  <a class="btn" href="/settings/addons">Edit jobs list</a>
</section>
<section class="card">
  <h2>Lender rules</h2>
  <p>Debt-to-income limits, rates and terms used to estimate each customer's max budget.</p>
  <a class="btn" href="/settings/lenders">Edit lender rules</a>
</section>
</div>
<section class="card">
  <h2>Backup</h2>
  <p>Download a complete copy of all customers, inventory, deals, payments and notes. Do this regularly and keep copies somewhere safe (e.g. a USB drive or cloud storage). Photos are stored separately in the uploads folder.</p>
  <a class="btn" href="/settings/backup">Download backup</a>
</section>
<%- include('partials/footer') %>

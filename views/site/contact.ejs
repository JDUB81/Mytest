<%- include('_head') %>
<section class="page-hero">
  <div class="wrap">
    <div class="crumbs"><a href="/">Home</a> / Contact</div>
    <h1>Contact us</h1>
    <p class="lead">Questions about a home, financing or your land? Send a message or stop by the lot.</p>
  </div>
</section>
<section class="section" style="padding-top:2.5rem">
  <div class="wrap two-col">
    <div>
      <%- include('_errors') %>
      <% if (home) { %><p>About: <a href="/homes/<%= home.id %>"><strong><%= home.year || '' %> <%= home.model %></strong></a></p><% } %>
      <%- include('_lead-form', { home: home, values: values }) %>
    </div>
    <div>
      <h2>Visit or call</h2>
      <ul class="info-list">
        <% if (site.business_address) { %><li><svg viewBox="0 0 24 24"><path d="M12 21s-7-4.5-7-11a7 7 0 0 1 14 0c0 6.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg><div class="prose"><%= site.business_address %><br><a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(site.business_address) %>" target="_blank" rel="noopener">Get directions</a></div></li><% } %>
        <% if (site.business_phone) { %><li><svg viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg><a href="tel:<%= site.business_phone.replace(/[^\d+]/g, '') %>"><%= site.business_phone %></a></li><% } %>
        <% if (site.business_email) { %><li><svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></svg><a href="mailto:<%= site.business_email %>"><%= site.business_email %></a></li><% } %>
        <li><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg><span><%= site.site_hours %></span></li>
      </ul>
    </div>
  </div>
</section>
<%- include('_foot') %>

<%- include('../partials/header') %>
<div class="page-head">
  <h1>Customers</h1>
  <div class="actions">
    <% if (isManager) { %><a class="btn" href="/reports/export/customers.csv">Export CSV</a><% } %>
    <a class="btn primary" href="/customers/new">+ New customer</a>
  </div>
</div>

<% const qs = function (over) { var p = Object.assign({}, filters, over); return Object.keys(p).filter(function (k) { return p[k]; }).map(function (k) { return k + '=' + encodeURIComponent(p[k]); }).join('&'); }; %>
<div class="pipeline">
  <a class="pipe <%= filters.stage === 'open' ? 'active' : '' %>" href="/customers?<%= qs({ stage: 'open' }) %>">All open</a>
  <% Object.keys(LEAD_STATUSES).forEach(function (k) { %>
    <a class="pipe pipe-<%= k %> <%= filters.stage === k ? 'active' : '' %>" href="/customers?<%= qs({ stage: k }) %>">
      <%= LEAD_STATUSES[k] %> <span class="count"><%= stageCounts[k] || 0 %></span></a>
  <% }) %>
  <a class="pipe <%= filters.stage === 'all' ? 'active' : '' %>" href="/customers?<%= qs({ stage: 'all' }) %>">Everyone</a>
</div>

<form method="get" action="/customers" class="filters">
  <input type="hidden" name="stage" value="<%= filters.stage %>">
  <input type="search" name="q" value="<%= filters.q %>" placeholder="Search name, phone, email, city…">
  <select name="owner" aria-label="Salesperson">
    <option value="all" <%= filters.owner === 'all' ? 'selected' : '' %>>Any salesperson</option>
    <option value="me" <%= filters.owner === 'me' ? 'selected' : '' %>>My customers</option>
    <option value="none" <%= filters.owner === 'none' ? 'selected' : '' %>>Unassigned</option>
  </select>
  <label class="check"><input type="checkbox" name="follow_up" value="due" <%= filters.follow_up ? 'checked' : '' %>> Follow-up due</label>
  <button class="btn" type="submit">Filter</button>
  <% if (filters.q || filters.owner !== 'all' || filters.follow_up) { %><a href="/customers?stage=<%= filters.stage %>">Clear</a><% } %>
</form>

<% if (!customers.length) { %>
  <div class="card muted">No customers match. <a href="/customers/new">Add a customer.</a></div>
<% } else { %>
  <div class="card table-wrap">
    <table>
      <thead><tr><th>Name</th><th>Phone</th><th>Stage</th><th>Source</th><th>Salesperson</th><th>Budget</th><th>Follow-up</th><th class="num">Deals</th></tr></thead>
      <tbody>
      <% customers.forEach(function (c) { %>
        <tr>
          <td><a href="/customers/<%= c.id %>"><strong><%= c.last_name %>, <%= c.first_name %></strong></a>
            <% if (c.co_buyer_name) { %><div class="small muted">&amp; <%= c.co_buyer_name %></div><% } %></td>
          <td><% if (c.phone) { %><a href="tel:<%= c.phone %>"><%= c.phone %></a><% } else { %><%= c.email || '—' %><% } %></td>
          <td><span class="stage stage-<%= c.lead_status %>"><%= LEAD_STATUSES[c.lead_status] || c.lead_status %></span></td>
          <td class="small"><%= c.lead_source || '—' %></td>
          <td class="small"><%= c.salesperson_name || '—' %></td>
          <td class="small"><%= c.budget ? formatMoney(c.budget) : '—' %></td>
          <td class="small <%= c.follow_up_date && c.follow_up_date <= today() ? 'overdue-text' : '' %>"><%= c.follow_up_date ? formatDate(c.follow_up_date) : '—' %></td>
          <td class="num"><%= c.deal_count %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
<%- include('../partials/footer') %>

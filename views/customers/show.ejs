<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <p class="crumb"><a href="/customers">Customers</a> /</p>
    <h1><%= customer.first_name %> <%= customer.last_name %>
      <span class="stage stage-<%= customer.lead_status %>"><%= LEAD_STATUSES[customer.lead_status] || customer.lead_status %></span></h1>
    <p class="muted"><%= customer.salesperson_name ? 'Salesperson: ' + customer.salesperson_name : 'No salesperson assigned' %>
      <%= customer.lead_source ? ' · Source: ' + customer.lead_source : '' %></p>
  </div>
  <div class="actions"><a class="btn" href="/customers/<%= customer.id %>/edit">Edit</a></div>
</div>

<form method="post" action="/customers/<%= customer.id %>/quick" class="quickbar card">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <label>Stage
    <select name="lead_status">
      <% Object.keys(LEAD_STATUSES).forEach(function (k) { %><option value="<%= k %>" <%= customer.lead_status === k ? 'selected' : '' %>><%= LEAD_STATUSES[k] %></option><% }) %>
    </select>
  </label>
  <label>Next follow-up <input type="date" name="follow_up_date" value="<%= customer.follow_up_date || '' %>"></label>
  <div class="quick-dates small">
    <% [[1,'Tomorrow'],[3,'3 days'],[7,'1 week'],[14,'2 weeks']].forEach(function (d) { %>
      <button class="link" type="button" data-days="<%= d[0] %>"><%= d[1] %></button>
    <% }) %>
  </div>
  <button class="btn" type="submit">Update</button>
</form>

<div class="grid-2">
  <section class="card">
    <h2>Contact</h2>
    <dl class="details">
      <dt>Phone</dt><dd><% if (customer.phone) { %><a href="tel:<%= customer.phone %>"><%= customer.phone %></a> · <a href="sms:<%= customer.phone %>">text</a><% } else { %>—<% } %></dd>
      <dt>Email</dt><dd><% if (customer.email) { %><a href="mailto:<%= customer.email %>"><%= customer.email %></a><% } else { %>—<% } %></dd>
      <dt>Prefers</dt><dd><%= customer.preferred_contact || '—' %></dd>
      <dt>Address</dt><dd><%= customer.address || '' %><% if (customer.city || customer.state || customer.zip) { %><br><%= [customer.city, customer.state].filter(Boolean).join(', ') %> <%= customer.zip || '' %><% } %><%= !customer.address && !customer.city && !customer.state && !customer.zip ? '—' : '' %></dd>
      <% if (customer.co_buyer_name) { %>
        <dt>Co-buyer</dt><dd><%= customer.co_buyer_name %>
          <% if (customer.co_buyer_phone) { %><br><a href="tel:<%= customer.co_buyer_phone %>"><%= customer.co_buyer_phone %></a><% } %>
          <% if (customer.co_buyer_email) { %><br><a href="mailto:<%= customer.co_buyer_email %>"><%= customer.co_buyer_email %></a><% } %></dd>
      <% } %>
      <dt>Added</dt><dd><%= formatDate(customer.created_at) %><%= customer.created_by_name ? ' by ' + customer.created_by_name : '' %></dd>
    </dl>
  </section>
  <section class="card">
    <h2>Looking for</h2>
    <dl class="details">
      <dt>Budget</dt><dd><%= customer.budget ? formatMoney(customer.budget) : '—' %></dd>
      <dt>Bedrooms</dt><dd><%= customer.desired_bedrooms ?? '—' %></dd>
      <dt>Financing</dt><dd><%= FINANCING_TYPES[customer.financing_pref] || '—' %></dd>
      <dt>Land</dt><dd><%= LAND_STATUSES[customer.land_status] || '—' %><%= customer.land_location ? ' — ' + customer.land_location : '' %></dd>
    </dl>
    <% if (customer.notes) { %><h3>Notes</h3><p class="notes"><%= customer.notes %></p><% } %>
  </section>
</div>

<section class="card" id="credit">
  <div class="card-head">
    <h2>Credit &amp; max budget</h2>
    <div class="actions">
      <a class="btn <%= creditApp ? '' : 'primary' %>" href="/customers/<%= customer.id %>/credit"><%= creditApp ? 'Edit credit application' : 'Start credit application' %></a>
      <% if (creditApp) { %><a class="btn" href="/customers/<%= customer.id %>/credit/print" target="_blank" rel="noopener">Print application</a><% } %>
    </div>
  </div>
  <% if (!creditApp) { %>
    <p class="muted">No credit application yet. Starting one copies in this customer's contact, co-buyer, land and home details. Once income and debts are entered, their max budget appears here.</p>
  <% } else if (!budget.best) { %>
    <p class="muted">Application saved <%= formatDate(creditApp.updated_at) %><%= creditApp.hasSsn ? ' · SSN on file' : '' %>. Enter monthly income on the application to estimate a max budget.</p>
  <% } else { %>
    <div class="stats">
      <div class="stat"><span class="num"><%= formatMoney(budget.best.maxPrice) %></span><span>Max budget (<%= budget.best.profile.name %>)</span></div>
      <div class="stat"><span class="num"><%= formatMoney(budget.best.payment) %>/mo</span><span>Max home payment</span></div>
      <div class="stat"><span class="num"><%= formatMoney(budget.best.income) %>/mo</span><span>Household income</span></div>
      <div class="stat"><span class="num"><%= formatMoney(budget.best.debts) %>/mo</span><span>Other debts</span></div>
    </div>
    <div class="table-wrap">
    <table class="compact">
      <thead><tr><th>Lender</th><th class="num">Max DTI</th><th class="num">Rate / term</th><th class="num">Payment</th><th class="num">Loan</th><th class="num">Down</th><th class="num">Max budget</th></tr></thead>
      <tbody>
      <% budget.results.forEach(function (r) { %>
        <tr>
          <td><%= r.profile.name %></td>
          <td class="num"><%= r.profile.dti_max %>%<%= r.profile.pti_max ? ' · PTI ' + r.profile.pti_max + '%' : '' %></td>
          <td class="num"><%= r.profile.rate %>% · <%= Math.round(r.profile.term_months / 12 * 10) / 10 %> yr</td>
          <td class="num"><%= formatMoney(r.payment) %></td>
          <td class="num"><%= formatMoney(r.loan) %></td>
          <td class="num"><%= formatMoney(r.down) %></td>
          <td class="num"><strong><%= formatMoney(r.maxPrice) %></strong><%= r.limitedByDown ? ' *' : '' %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
    </div>
    <p class="hint">Payment = (max DTI × income) − other debts − lot rent − <%= formatMoney(budget.insuranceMonthly) %>/mo insurance estimate. Max budget = the loan that payment supports + down payment<%= budget.results.some(function (r) { return r.limitedByDown; }) ? '; * limited by the minimum down payment' : '' %>. These are estimates, not lender decisions.<% if (isManager) { %> <a href="/settings/lenders">Edit lender rules</a><% } %></p>
    <h3>In-stock homes that fit<%= customer.desired_bedrooms ? ' (' + customer.desired_bedrooms + '+ bedrooms)' : '' %></h3>
    <% if (!homesThatFit.length) { %><p class="muted">No available homes at or under <%= formatMoney(budget.best.maxPrice) %>.</p><% } else { %>
      <ul class="plain">
        <% homesThatFit.forEach(function (h) { %>
          <li><a href="/inventory/<%= h.id %>">#<%= h.stock_number %></a> <%= h.year || '' %> <%= h.manufacturer %> <%= h.model %> · <%= h.bedrooms ?? '?' %> bd / <%= h.bathrooms ?? '?' %> ba · <strong><%= formatMoney(h.price) %></strong>
            <span class="small muted">(<%= formatMoney(budget.best.maxPrice - h.price) %> under max)</span></li>
        <% }) %>
      </ul>
    <% } %>
  <% } %>
</section>

<div class="grid-2">
  <section class="card" id="lenders">
    <h2>Lender submissions</h2>
    <% if (!submissions.length) { %><p class="muted">Not sent to any lender yet.</p><% } else { %>
      <% submissions.forEach(function (sub) { %>
        <details class="submission status-box-<%= sub.status %>">
          <summary>
            <strong><%= sub.lender %></strong> <span class="app-status app-<%= sub.status %>"><%= APPLICATION_STATUSES[sub.status] %></span>
            <span class="small muted">sent <%= formatDate(sub.submitted_on) %><%= sub.amount_approved ? ' · approved ' + formatMoney(sub.amount_approved) : '' %><%= sub.rate ? ' @ ' + sub.rate + '%' : '' %><%= sub.term_months ? ' / ' + sub.term_months + ' mo' : '' %><%= sub.payment ? ' · ' + formatMoney(sub.payment) + '/mo' : '' %></span>
          </summary>
          <form method="post" action="/customers/<%= customer.id %>/submissions/<%= sub.id %>" class="submission-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label>Status <select name="status"><% Object.keys(APPLICATION_STATUSES).forEach(function (k) { %><option value="<%= k %>" <%= sub.status === k ? 'selected' : '' %>><%= APPLICATION_STATUSES[k] %></option><% }) %></select></label>
            <label>Requested ($) <input name="amount_requested" inputmode="decimal" value="<%= sub.amount_requested ?? '' %>"></label>
            <label>Approved ($) <input name="amount_approved" inputmode="decimal" value="<%= sub.amount_approved ?? '' %>"></label>
            <label>Rate (%) <input name="rate" inputmode="decimal" value="<%= sub.rate ?? '' %>"></label>
            <label>Term (months) <input name="term_months" inputmode="numeric" value="<%= sub.term_months ?? '' %>"></label>
            <label>Payment ($/mo) <input name="payment" inputmode="decimal" value="<%= sub.payment ?? '' %>"></label>
            <label class="span-all">Conditions / stips <input name="conditions" value="<%= sub.conditions || '' %>"></label>
            <label class="span-all">Notes <input name="notes" value="<%= sub.notes || '' %>"></label>
            <button class="btn" type="submit">Update</button>
          </form>
        </details>
      <% }) %>
    <% } %>
    <form method="post" action="/customers/<%= customer.id %>/submissions" class="inline-form new-submission">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input name="lender" list="lender-list" placeholder="Lender (e.g. 21st Mortgage)" required>
      <datalist id="lender-list"><% lenderNames.concat(['21st Mortgage', 'Triad Financial', 'Vanderbilt Mortgage', 'CountryPlace Mortgage', 'Cascade Financial', 'ELT / Credit Human']).filter(function (n, i, a) { return a.indexOf(n) === i; }).forEach(function (n) { %><option><%= n %></option><% }) %></datalist>
      <input type="date" name="submitted_on" value="<%= today() %>" aria-label="Date sent">
      <input name="amount_requested" inputmode="decimal" placeholder="Amount requested" class="short">
      <button class="btn" type="submit">Record submission</button>
    </form>
  </section>

  <section class="card" id="documents">
    <h2>Documents <span class="small muted"><%= Object.keys(documents).length %> of <%= Object.keys(DOCUMENT_TYPES).length %></span></h2>
    <form method="post" action="/customers/<%= customer.id %>/documents" class="doc-list">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% Object.keys(DOCUMENT_TYPES).forEach(function (k) { var d = documents[k]; %>
        <label class="check"><input type="checkbox" name="docs" value="<%= k %>" <%= d ? 'checked' : '' %>> <span><%= DOCUMENT_TYPES[k] %><% if (d) { %> <span class="small muted">— <%= formatDate(d.received_on) %><%= d.full_name ? ', ' + d.full_name : '' %></span><% } %></span></label>
      <% }) %>
      <button class="btn" type="submit">Save checklist</button>
    </form>
  </section>
</div>

<section class="card">
  <h2>Homes &amp; deals</h2>
  <% if (!deals.length) { %>
    <p class="muted">No homes assigned yet.</p>
  <% } else { %>
    <div class="table-wrap">
    <table>
      <thead><tr><th>Deal</th><th>Stock #</th><th>Home</th><th class="num">Sale price</th><th>Status</th><th>Opened</th></tr></thead>
      <tbody>
      <% deals.forEach(function (d) { %>
        <tr>
          <td><a href="/deals/<%= d.id %>"><strong>#<%= d.id %></strong></a></td>
          <td><a href="/inventory/<%= d.inventory_id %>"><%= d.stock_number %></a></td>
          <td><%= d.year || '' %> <%= d.manufacturer %> <%= d.model %></td>
          <td class="num"><%= formatMoney(d.sale_price - d.discount) %></td>
          <td><span class="status status-<%= d.status %>"><%= statusLabel(d.status) %></span></td>
          <td class="small"><%= formatDate(d.created_at) %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
    </div>
  <% } %>

  <h3>Assign an available home</h3>
  <% if (!availableHomes.length) { %>
    <p class="muted">There are no available homes in inventory right now.</p>
  <% } else { %>
    <form method="post" action="/inventory/assign" class="inline-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="customer_id" value="<%= customer.id %>">
      <input type="hidden" name="from" value="customer">
      <select name="inventory_id" required>
        <option value="">Choose a home…</option>
        <% availableHomes.forEach(function (h) { %>
          <option value="<%= h.id %>">#<%= h.stock_number %> — <%= h.year || '' %> <%= h.manufacturer %> <%= h.model %><%= h.bedrooms ? ', ' + h.bedrooms + ' bd' : '' %> (<%= formatMoney(h.price) %>)</option>
        <% }) %>
      </select>
      <button class="btn primary" type="submit">Assign &amp; open deal</button>
    </form>
  <% } %>
</section>

<div class="grid-2">
  <section class="card" id="timeline">
    <h2>Notes &amp; history</h2>
    <%- include('../partials/note-form', { field: 'customer_id', value: customer.id }) %>
    <%- include('../partials/timeline', { entries: timeline }) %>
  </section>

  <section class="card" id="tasks">
    <h2>Tasks</h2>
    <form method="post" action="/tasks" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="customer_id" value="<%= customer.id %>">
      <input type="hidden" name="from" value="customer">
      <input name="title" placeholder="e.g. Call back about credit app" required>
      <div class="grid-2 tight">
        <input type="date" name="due_date" value="<%= today(1) %>" aria-label="Due date">
        <select name="assigned_to" aria-label="Assigned to">
          <% staff.forEach(function (u) { %><option value="<%= u.id %>" <%= u.id === user.id ? 'selected' : '' %>><%= u.full_name %></option><% }) %>
        </select>
      </div>
      <button class="btn" type="submit">Add task</button>
    </form>
    <% if (tasks.length) { %>
      <ul class="task-list">
        <% tasks.forEach(function (t) { %>
          <li class="<%= t.done_at ? 'done' : (t.due_date && t.due_date < today() ? 'overdue' : '') %>">
            <form method="post" action="/tasks/<%= t.id %>/<%= t.done_at ? 'reopen' : 'done' %>" class="inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="from" value="customer">
              <button class="check-btn <%= t.done_at ? 'checked' : '' %>" type="submit" title="<%= t.done_at ? 'Reopen' : 'Mark done' %>">✓</button>
            </form>
            <div><strong><%= t.title %></strong>
              <div class="small muted"><%= t.due_date ? formatDate(t.due_date) : 'No due date' %> · <%= t.assigned_name || 'Unassigned' %></div></div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</div>

<% if (isManager && !deals.length) { %>
  <form method="post" action="/customers/<%= customer.id %>/delete" class="danger-zone"
        onsubmit="return confirm('Delete this customer and their notes? This cannot be undone.')">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn danger" type="submit">Delete customer</button>
  </form>
<% } %>
<script src="/app.js"></script>
<%- include('../partials/footer') %>
